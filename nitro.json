{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "HelloWorld"
  ],
  "ios": {
    "iosModuleName": "NitroHelloworld"
  },
  "android": {
    "androidNamespace": [
      "HelloWorld"
    ],
    "androidCxxLibName": "NitroHelloworld"
  },
"autolinking": {
    "HelloWorld": {
    "android": {
      "language": "kotlin",
      "implementationClassName": "HybridHelloWorld"
    }
  }
    
},
  "ignorePaths": [
    "**/node_modules"
  ]
}
